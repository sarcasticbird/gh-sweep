#!/usr/bin/env bash
set -euo pipefail

VERSION="0.4.0"
DRY_RUN=false AUTO=false VERBOSE=false ALL=false INCLUDE_FAILED=false
DEPTH=0 KEEP_RUNS=5 SELECTED_USER="" COMMAND=all PR_NUMBER=""
SWEEP_LIB="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib"

# Hooks (including fsmonitor during status) are arbitrary delegates, not part of
# a captured cleanup plan. Keep ordinary repository configuration and identity.
git() { command git -c core.hooksPath=/dev/null -c core.fsmonitor=false "$@"; }

usage() {
  cat <<EOF
gh-sweep v${VERSION} - preview and clean GitHub resources
Usage: gh sweep [branches|local|remote|orphans|comments <pr>|caches|runs|notifications] [flags]
Without a command, plan a full sweep across discovered repositories.
  --user LOGIN      Restrict attributable resources; skip unsupported categories
  --keep-runs N     Retain newest N eligible runs per workflow (default 5; positive)
  --include-failed  Include failure, timed_out and startup_failure in run retention
  --all             All branch authors; add other known non-failed run conclusions
  --depth N         Repository discovery depth (default 0)
  --dry-run         Exact preview; no cleanup, installation, fetch/prune or delegates
  --auto            Execute the displayed plan without waiting for confirmation
  --verbose         Additional diagnostics
  --version         Print version
  --help            Show help
EOF
}

parse_args() {
  if [[ $# -gt 0 && "$1" != -* ]]; then
    case "$1" in
      branches|local|remote|orphans|caches|runs|notifications) COMMAND="$1"; shift ;;
      comments) COMMAND=comments; shift; PR_NUMBER="${1:-}"; [[ $# -gt 0 ]] && shift ;;
      *) echo "error: unknown command: $1" >&2; return 1 ;;
    esac
  fi
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --user)
        [[ "${2:-}" =~ ^[A-Za-z0-9][A-Za-z0-9-]*(\[bot\])?$ ]] || { echo 'error: --user requires a login' >&2; return 1; }
        SELECTED_USER="$2"; shift 2 ;;
      --keep-runs)
        [[ "${2:-}" =~ ^[1-9][0-9]*$ ]] || { echo 'error: --keep-runs requires a positive integer' >&2; return 1; }
        # jq numbers are exact up to 2^53; larger values can safely retain everything.
        KEEP_RUNS="$2"
        if [[ ${#KEEP_RUNS} -gt 16 ]] || [[ ${#KEEP_RUNS} -eq 16 && "$KEEP_RUNS" -gt 9007199254740991 ]]; then
          KEEP_RUNS=9007199254740991
        fi
        shift 2 ;;
      --depth)
        [[ "${2:-}" =~ ^[0-9]{1,4}$ ]] || { echo 'error: --depth requires an integer from 0 to 9999' >&2; return 1; }
        DEPTH=$((10#$2)); shift 2 ;;
      --all) ALL=true; shift ;;
      --include-failed) INCLUDE_FAILED=true; shift ;;
      --dry-run) DRY_RUN=true; shift ;;
      --auto) AUTO=true; shift ;;
      --verbose) VERBOSE=true; shift ;;
      --version) echo "gh-sweep v$VERSION"; return 2 ;;
      --help|-h) usage; return 2 ;;
      *) echo "error: unknown flag: $1" >&2; return 1 ;;
    esac
  done
  if [[ "$COMMAND" == comments && ! "$PR_NUMBER" =~ ^[1-9][0-9]*$ ]]; then
    echo 'error: comments requires a positive PR number' >&2; return 1
  fi
}

checked_out_branch() { git -C "$1" rev-parse --abbrev-ref HEAD; }
is_protected_branch() {
  case "$1" in main|master|develop) return 0 ;; *) return 1 ;; esac
}

discover_repos() {
  local result
  if [[ "$DEPTH" -eq 0 ]]; then
    result="$(git rev-parse --show-toplevel)" || { echo 'error: not in a repository' >&2; return 1; }
    [[ "$result" != *$'\n'* ]] || { echo 'error: newline in repository path is unsupported' >&2; return 1; }
    printf '%s\n' "$result"
    return
  fi
  local repos=() keys=() gitpath dir key i seen paths current candidate
  paths="$(mktemp)" || return 1
  find . -mindepth 2 -maxdepth "$((DEPTH+1))" -name .git -type d -print0 > "$paths" || { rm -f "$paths"; return 1; }
  find . -mindepth 2 -maxdepth "$((DEPTH+2))" -name .git -type f -print0 >> "$paths" || { rm -f "$paths"; return 1; }
  # The private inventory is only removed on abort, never rewritten while read.
  # shellcheck disable=SC2094
  while IFS= read -r -d '' gitpath; do
    dir="$(cd "$(dirname "$gitpath")" && pwd -P)" || return 1
    [[ "$dir" != *$'\n'* ]] || { rm -f "$paths"; echo 'error: newline in repository path is unsupported' >&2; return 1; }
    key="$(cd "$dir" && cd "$(git rev-parse --git-common-dir)" && pwd -P)" || return 1
    [[ -f "$gitpath" && "$(dirname "$key")" != "$(dirname "$dir")" ]] && continue
    seen=false
    for ((i=0; i<${#keys[@]}; i++)); do
      if [[ "${keys[$i]}" == "$key" ]]; then
        seen=true
        current="$(checked_out_branch "${repos[$i]}")" || { rm -f "$paths"; return 1; }
        candidate="$(checked_out_branch "$dir")" || { rm -f "$paths"; return 1; }
        if ! is_protected_branch "$current" && is_protected_branch "$candidate"; then
          repos[i]="$dir"
        fi
        break
      fi
    done
    if [[ "$seen" == false ]]; then keys+=("$key"); repos+=("$dir"); fi
  done < "$paths"
  rm -f "$paths"
  if [[ ${#repos[@]} -eq 0 ]]; then
    result="$(git rev-parse --show-toplevel)" || { echo 'error: no repositories found' >&2; return 1; }
    [[ "$result" != *$'\n'* ]] || return 1
    printf '%s\n' "$result"
  else
    printf '%s\n' "${repos[@]}" | sort
  fi
}

# shellcheck source=lib/sweep.sh
source "$SWEEP_LIB/sweep.sh"

main() {
  local status=0
  parse_args "$@" || status=$?
  [[ "$status" -eq 2 ]] && return 0
  [[ "$status" -ne 0 ]] && return "$status"
  safe_sweep
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then main "$@"; fi
